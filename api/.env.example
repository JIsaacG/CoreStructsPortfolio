# Variables del endpoint de contacto.
#
# En producción NO hace falta este archivo: las mismas claves se cargan en
# hPanel → tu sitio → Variables de entorno (el botón "Importar .env" acepta
# este formato tal cual). Lo que esté en el entorno gana siempre.
#
# En local, copia este archivo a `.env` en la misma carpeta y rellénalo:
#
#   cp api/.env.example api/.env
#
# `.env` está en .gitignore. Este ejemplo no lleva secretos y sí se versiona.

# --- obligatorias -----------------------------------------------------------

# Buzón que se autentica contra el servidor de salida.
SMTP_USER=buzon@tudominio.com
SMTP_PASS=la-contraseña-del-buzón

# Remitente que ve quien recibe. Tiene que ser el mismo buzón que SMTP_USER:
# Hostinger rechaza enviar en nombre de otra dirección, y es lo que hace que
# SPF y DKIM cuadren y el correo no acabe en spam.
MAIL_FROM=buzon@tudominio.com

# A dónde llegan las solicitudes del formulario. Admite varias, con comas.
MAIL_TO=contacto@tudominio.com

# --- opcionales (estos son los valores por defecto) -------------------------

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# true en el 465 (TLS desde el saludo), false en el 587 (STARTTLS).
SMTP_SECURE=true

MAIL_FROM_NAME=CoreStruct

# Dominios ajenos que pueden llamar al endpoint, con comas. El propio dominio
# del sitio pasa siempre, así que normalmente esto se deja vacío.
ALLOWED_ORIGINS=

# Tope de envíos por IP, para que el endpoint no sea una manguera de spam.
RATE_LIMIT=5
RATE_WINDOW=600

# true devuelve el diálogo SMTP completo en la respuesta. Solo para depurar.
MAIL_DEBUG=false
