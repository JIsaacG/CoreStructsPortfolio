---
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { marca, paseo } from '../data/sitio';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const og = await getImage({ src: paseo.paradas[0].poster, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
---

<!doctype html>
<html lang="es-HN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Demo de CoreStruct: el restaurante es ficticio y nunca debe llegar a un buscador como real. -->
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#0d1510" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_HN" />
    <meta property="og:site_name" content={`${marca.nombre} ${marca.descriptor}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="La casa de Maison Verde entre el jardín" />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-outfit" preload />
  </head>
  <body class="min-h-svh overflow-x-clip">
    <Header />
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <a
      href="../../#proyectos"
      class="fixed right-4 bottom-4 z-30 flex lg:top-8 lg:right-8 lg:bottom-auto items-center gap-2 rounded-full bg-bg/70 px-3 py-2 text-xs text-crema/80 ring-1 ring-crema/15 backdrop-blur-xl transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:text-crema"
    >
      <span aria-hidden="true" class="size-2 rounded-full bg-teja"></span>
      Sitio ficticio · CoreStruct
    </a>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
