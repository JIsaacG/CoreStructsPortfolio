---
import Logo from './Logo.astro';
import { marca } from '../data/sitio';
---

<footer class="px-4 py-12 md:px-12 xl:px-24">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 border-t border-crema/10 pt-8 md:flex-row md:items-start md:justify-between">
    <div class="flex flex-col gap-2">
      <Logo />
      <p class="text-sm text-crema/60">
        © 2026 {marca.nombre} {marca.descriptor}. Sitio creado por <a href="../../" class="link">CoreStruct</a>.
      </p>
    </div>
    <p class="max-w-md text-sm text-crema/60 md:text-right">
      Este edificio no existe: es una demostración de CoreStruct. El recorrido en video, los modelos y el formulario
      sí funcionan, y así funcionarían con las fotos y los datos de tu proyecto.
    </p>
  </div>
</footer>
