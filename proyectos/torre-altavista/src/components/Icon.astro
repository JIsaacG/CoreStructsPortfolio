---
import arrowDown from '@phosphor-icons/core/assets/light/arrow-down-light.svg?raw';
import calendar from '@phosphor-icons/core/assets/light/calendar-check-light.svg?raw';
import check from '@phosphor-icons/core/assets/light/check-circle-light.svg?raw';
import drop from '@phosphor-icons/core/assets/light/drop-light.svg?raw';
import house from '@phosphor-icons/core/assets/light/house-line-light.svg?raw';
import lightning from '@phosphor-icons/core/assets/light/lightning-light.svg?raw';
import mapPin from '@phosphor-icons/core/assets/light/map-pin-light.svg?raw';
import plus from '@phosphor-icons/core/assets/light/plus-light.svg?raw';
import shield from '@phosphor-icons/core/assets/light/shield-check-light.svg?raw';
import sun from '@phosphor-icons/core/assets/light/sun-light.svg?raw';

const icons = { arrowDown, calendar, check, drop, house, lightning, mapPin, plus, shield, sun };
export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-4' } = Astro.props;
const svg = icons[name].replace('<svg ', `<svg aria-hidden="true" focusable="false" class="${className}" `);
---

<Fragment set:html={svg} />
