---
import { paseo } from '../data/sitio';

// Una parada del recorrido. El artículo marca la distancia de scroll; su texto queda abajo a la izquierda
// mientras la cámara avanza y sale cuando llega la parada siguiente.
interface Props {
  index: number;
  eyebrow?: string;
}

const { index, eyebrow } = Astro.props;
const parada = paseo.paradas[index];
const dos = (n: number) => String(n).padStart(2, '0');
---

<article
  id={parada.id}
  data-parada
  data-focus={parada.focus}
  data-spy="#inicio"
  class="parada pointer-events-none flex min-h-[160svh] flex-col justify-end"
>
  <div
    class:list={[
      "parada-cuerpo pointer-events-auto sticky bottom-0 flex w-full max-w-2xl flex-col items-start px-4 pt-24 pb-12 md:px-12 lg:pb-16 xl:px-20",
      // En móvil el texto taparía el recorrido: solo la primera vista lo muestra.
      index > 0 && "max-lg:sr-only",
    ]}
  >
    <p class="flex items-center gap-2 text-xs tracking-widest text-crema/60 uppercase">
      <span class="tabular-nums">{dos(index + 1)} / {dos(paseo.paradas.length)}</span>
      <span aria-hidden="true" class="size-1 rounded-full bg-oro"></span>
      <span>{parada.lugar}</span>
    </p>
    {eyebrow && <p class="mt-4 text-xs font-medium tracking-widest text-oro uppercase">{eyebrow}</p>}
    <slot />
  </div>
</article>

<style>
  :global(.js) .parada-cuerpo > :global(*) {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 700ms var(--ease-fluid),
      transform 700ms var(--ease-fluid);
  }

  :global(.js) .parada.es-actual .parada-cuerpo > :global(*),
  :global(.js) .parada-cuerpo:focus-within > :global(*) {
    opacity: 1;
    transform: none;
    transition-duration: 1000ms;
  }

  .parada.es-actual .parada-cuerpo > :global(:nth-child(2)) { transition-delay: 60ms; }
  .parada.es-actual .parada-cuerpo > :global(:nth-child(3)) { transition-delay: 120ms; }
  .parada.es-actual .parada-cuerpo > :global(:nth-child(4)) { transition-delay: 180ms; }
  .parada.es-actual .parada-cuerpo > :global(:nth-child(5)) { transition-delay: 240ms; }
  .parada.es-actual .parada-cuerpo > :global(:nth-child(6)) { transition-delay: 300ms; }

  :global(.js) .parada:not(.es-actual) .parada-cuerpo:not(:focus-within) {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .parada-cuerpo > :global(*) {
      transform: none;
    }
  }
</style>
