---
import Logo from './Logo.astro';
import { asesora, nav } from '../data/sitio';
---

<a href="#contenido" class="btn btn-primary btn-sm fixed top-4 left-4 z-[60] -translate-y-24 focus-visible:translate-y-0">
  Saltar al contenido
</a>

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center px-4 pt-6 lg:justify-start lg:px-12 xl:px-20">
  <div class="pointer-events-auto flex w-max items-center gap-3 rounded-full bg-bg/60 p-2 pl-4 sm:gap-6 sm:pl-6 ring-1 ring-crema/10 backdrop-blur-xl">
    <a href="#inicio" class="flex h-9 items-center rounded-full" aria-label="Alameda Bienes Raíces, volver al inicio">
      <Logo />
    </a>

    <nav aria-label="Principal" class="relative hidden lg:block">
      <span aria-hidden="true" class="indicador absolute top-0 left-0 h-9 rounded-full bg-crema/[0.07]"></span>
      <ul class="relative flex items-center text-sm">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav
                class="flex h-9 items-center rounded-full px-3 text-crema/70 transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:text-crema aria-[current=true]:text-crema"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a href="#contacto" class="btn btn-primary btn-sm whitespace-nowrap">Agendar visita</a>
      <button
        type="button"
        class="alternar-menu relative size-9 rounded-full text-crema transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-crema/10 lg:hidden"
        aria-expanded="false"
        aria-controls="menu"
        aria-label="Abrir menú"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div
  id="menu"
  class="menu invisible fixed inset-0 z-40 flex flex-col justify-between bg-bg/80 px-4 pt-24 pb-12 opacity-0 backdrop-blur-3xl transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] lg:hidden"
  inert
>
  <nav aria-label="Menú móvil">
    <ul class="flex flex-col items-center gap-6 text-center">
      {
        nav.map((item, i) => (
          <li class="menu-item" style={`--i:${i}`}>
            <a href={item.href} data-menu-link class="text-4xl text-crema">
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="menu-item pt-6" style={`--i:${nav.length}`}>
        <a href="#contacto" data-menu-link class="btn btn-primary">Agendar visita</a>
      </li>
    </ul>
  </nav>
  <p class="menu-item text-center text-sm text-crema/70" style={`--i:${nav.length + 1}`}>
    {asesora.horario}
  </p>
</div>

<style>
  .alternar-menu span {
    position: absolute;
    top: 50%;
    left: 10px;
    width: 16px;
    height: 1.5px;
    margin-top: -0.75px;
    border-radius: 9999px;
    background-color: currentColor;
    transition: transform 700ms var(--ease-fluid);
  }

  .alternar-menu span:nth-child(1) { transform: translateY(-3px); }
  .alternar-menu span:nth-child(2) { transform: translateY(3px); }
  .alternar-menu[aria-expanded='true'] span:nth-child(1) { transform: rotate(45deg); }
  .alternar-menu[aria-expanded='true'] span:nth-child(2) { transform: rotate(-45deg); }

  .menu[data-abierto] {
    visibility: visible;
    opacity: 1;
  }

  .menu-item {
    opacity: 0;
    transform: translateY(3rem);
    transition:
      opacity 700ms var(--ease-fluid),
      transform 700ms var(--ease-fluid);
  }

  .menu[data-abierto] .menu-item {
    opacity: 1;
    transform: none;
    transition-delay: calc(100ms + var(--i, 0) * 50ms);
  }

  /* Píldora que se desliza hasta la sección activa. */
  .indicador {
    width: var(--w, 0);
    translate: var(--x, 0) 0;
    opacity: 0;
    transition:
      translate 700ms var(--ease-fluid),
      width 700ms var(--ease-fluid),
      opacity 700ms var(--ease-fluid);
  }

  .indicador[data-visible] { opacity: 1; }
  .indicador[data-instantaneo] { transition: opacity 700ms var(--ease-fluid); }
</style>

<script>
  const alternar = document.querySelector<HTMLButtonElement>('.alternar-menu');
  const menu = document.getElementById('menu');
  const main = document.getElementById('contenido');
  const pie = document.querySelector('footer');

  const abrir = (abierto: boolean) => {
    if (!alternar || !menu) return;
    alternar.setAttribute('aria-expanded', String(abierto));
    alternar.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
    menu.toggleAttribute('data-abierto', abierto);
    menu.inert = !abierto;
    if (main) main.inert = abierto;
    if (pie) pie.inert = abierto;
    if (abierto) {
      window.lenis?.stop();
      menu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
    } else {
      window.lenis?.start();
    }
  };

  alternar?.addEventListener('click', () => abrir(alternar.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('keydown', (evento) => {
    if (evento.key === 'Escape' && alternar?.getAttribute('aria-expanded') === 'true') {
      abrir(false);
      alternar.focus();
    }
  });

  menu?.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((enlace) => {
    enlace.addEventListener('click', (evento) => {
      const destino = document.querySelector<HTMLElement>(enlace.hash);
      if (!destino) return;
      evento.preventDefault();
      abrir(false);
      if (window.lenis) window.lenis.scrollTo(destino);
      else destino.scrollIntoView();
    });
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (evento) => {
    if (evento.matches) abrir(false);
  });

  // Indica en la navegación la sección que se está viendo.
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const indicador = document.querySelector<HTMLElement>('.indicador');

  const moverIndicador = () => {
    if (!indicador) return;
    const activo = enlaces.find((a) => a.getAttribute('aria-current') === 'true');
    if (!activo) {
      indicador.removeAttribute('data-visible');
      return;
    }
    indicador.toggleAttribute('data-instantaneo', !indicador.hasAttribute('data-visible'));
    indicador.style.setProperty('--x', `${activo.offsetLeft}px`);
    indicador.style.setProperty('--w', `${activo.offsetWidth}px`);
    void indicador.offsetWidth;
    indicador.removeAttribute('data-instantaneo');
    indicador.setAttribute('data-visible', '');
  };

  const espia = new IntersectionObserver(
    (entradas) => {
      for (const entrada of entradas) {
        if (!entrada.isIntersecting) continue;
        const href = (entrada.target as HTMLElement).dataset.spy;
        enlaces.forEach((a) => a.setAttribute('aria-current', String(a.getAttribute('href') === href)));
        moverIndicador();
      }
    },
    { rootMargin: '-50% 0px -50% 0px' },
  );
  document.querySelectorAll('[data-spy]').forEach((el) => espia.observe(el));
</script>
