---
import Icon, { type IconName } from './Icon.astro';
import { beneficios, modelos, proyecto } from '../data/sitio';
---

<section id="modelos" data-spy="#modelos" aria-labelledby="modelos-titulo" class="px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto max-w-6xl">
    <p data-reveal class="text-sm text-oro">Modelos</p>
    <h2 id="modelos-titulo" data-reveal style="--d:100ms" class="mt-4 max-w-xl text-3xl lg:text-5xl">
      Elige el apartamento que va con tu vida
    </h2>
    <p data-reveal style="--d:200ms" class="mt-6 max-w-md text-base text-crema/70">
      {proyecto.unidades} apartamentos en {proyecto.pisos} pisos, todos con terraza y parqueo asignado.
    </p>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        modelos.map((m, i) => (
          <li
            data-reveal
            style={`--d:${150 + i * 100}ms`}
            class:list={[
              'flex flex-col rounded-3xl bg-superficie p-8 ring-1',
              m.destacado ? 'ring-oro' : 'ring-crema/10',
            ]}
          >
            <div class="flex items-center justify-between gap-4">
              <h3 class="text-2xl">{m.nombre}</h3>
              {m.destacado && <span class="rounded-full bg-oro px-3 py-1 text-xs font-semibold text-bg">Más elegido</span>}
            </div>
            <p class="mt-2 text-sm text-crema/60">Desde</p>
            <p class="text-3xl font-medium">{m.precio}</p>
            <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-crema/10">
              {[
                ['Habitaciones', m.habitaciones],
                ['Baños', m.banos],
                ['Área', m.area],
                ['Parqueos', m.parqueos],
              ].map(([dt, dd]) => (
                <div class="flex flex-col-reverse gap-1 bg-superficie p-4">
                  <dt class="text-xs text-crema/60">{dt}</dt>
                  <dd class="text-xl">{dd}</dd>
                </div>
              ))}
            </dl>
            <a href="#contacto" class:list={['btn mt-8 w-full', m.destacado ? 'btn-primary' : 'btn-ghost']}>
              Agendar visita
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="mt-24 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        beneficios.map((b, i) => (
          <li data-reveal style={`--d:${100 + i * 80}ms`} class="flex flex-col gap-3">
            <span class="grid size-10 place-items-center rounded-full bg-crema/5 ring-1 ring-crema/10">
              <Icon name={b.icono as IconName} class="size-6 text-oro" />
            </span>
            <h3 class="text-lg">{b.titulo}</h3>
            <p class="text-base text-crema/70">{b.detalle}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
