# Dependencias (el proyecto no tiene ninguna en runtime, pero npm puede crearlas)
node_modules/

# Sistema operativo / editores
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Inventario de textos sin traducir (lo regenera npm run build:i18n)
tools/i18n-missing.txt

# Credenciales SMTP del formulario, solo para desarrollo local. En producción
# van en hPanel → Variables de entorno, no en un archivo.
# Plantilla versionada: api/.env.example
api/.env
.env

# Máquina de Reels: crudos, temporales e intermedios no se suben (ver PROMPT_REELS.md)
content/reels/raw/
content/reels/tmp/
content/reels/**/*.webm
content/reels/**/*.wav
# Proyectos de video: assets/ (clips grabados, fuentes, GSAP, logo) lo regenera
# `npm run build`; capturas y renders de HyperFrames son intermedios.
# Solo se suben reel.json, index.html y los MP4 finales de out/<ID>/.
content/reels/videos/*/assets/
content/reels/videos/*/snapshots/
content/reels/videos/*/renders/
content/reels/videos/*/.thumbnails/
content/reels/node_modules/
